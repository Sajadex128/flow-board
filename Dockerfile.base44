# Development image for the Base44 sandbox.
#
# Only the dependency manifests are baked in — the application source is
# bind-mounted at runtime (see docker-compose.base44.yml) so edits are picked up
# by `next dev` without rebuilding the image.
FROM node:22-bookworm-slim

ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

EXPOSE 3000
